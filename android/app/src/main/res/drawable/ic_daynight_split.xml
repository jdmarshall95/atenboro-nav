        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M4.42,15.14 L2.58,15.9"
        android:strokeColor="@color/gold"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M3.8,12 L1.8,12"
        android:strokeColor="@color/gold"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
</vector>
