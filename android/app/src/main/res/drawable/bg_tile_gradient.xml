<?xml version="1.0" encoding="utf-8"?>
<!-- Тайл статуса: нейтральная поверхность с тёплым золотым краем -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:centerColor="@color/grad_tile_center"
        android:endColor="@color/grad_tile_end"
        android:startColor="@color/grad_tile_start"
        android:type="linear" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/stroke" />
</shape>
