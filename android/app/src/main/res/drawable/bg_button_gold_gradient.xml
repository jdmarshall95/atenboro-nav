<?xml version="1.0" encoding="utf-8"?>
<!-- Золотая металлик-кнопка: блик слева сверху, тёмный край справа снизу -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="@color/grad_btn_center"
        android:endColor="@color/grad_btn_end"
        android:startColor="@color/grad_btn_start"
        android:type="linear" />
    <corners android:radius="16dp" />
</shape>
