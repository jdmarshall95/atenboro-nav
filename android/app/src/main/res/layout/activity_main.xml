<?xml version="1.0" encoding="utf-8"?>
<!--
  Основной экран: один экран без прокрутки.
  Шапка (бренд + день/ночь + шестерёнка), статусы подключений и две кнопки.
  Всё остальное — в SettingsActivity.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window_glow"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <!-- ШАПКА: бренд + переключатель день/ночь + шестерёнка -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/heroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/gold_outline"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_gradient"
            android:padding="20dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="150dp"
                android:layout_height="44dp"
                android:contentDescription="@string/desc_logo"
                android:scaleType="fitStart"
                android:src="@drawable/ic_atenboro_logo_white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/header_subtitle"
                android:textColor="@color/gold_bright"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btnTheme"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgLogo" />

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_settings"
                android:padding="9dp"
                android:src="@drawable/ic_settings_gold"
                app:layout_constraintEnd_toStartOf="@id/btnTheme"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btnTheme"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_theme"
                android:padding="7dp"
                android:src="@drawable/ic_daynight_split"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- СТАТУС: только то, что должно работать -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toTopOf="@+id/btnStartProxy"
        app:layout_constraintTop_toBottomOf="@id/heroCard"
        app:layout_constraintVertical_chainStyle="packed">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/section_status"
                android:textAppearance="@style/TextAppearance.AtenboroNav.Section" />

            <!-- Плата ESP8266 -->
            <LinearLayout
                android:id="@+id/rowEsp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tile_gradient"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <View
                    android:id="@+id/dotEsp"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/dot_status_gray" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/row_esp"
                    android:textAppearance="@style/TextAppearance.AtenboroNav.Row" />

                <TextView
                    android:id="@+id/statusEsp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/state_checking"
                    android:textAppearance="@style/TextAppearance.AtenboroNav.Caption" />
            </LinearLayout>

            <!-- 2ГИС AIDL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <View
                    android:id="@+id/dotGisApi"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/dot_status_gray" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/row_aidl"
                    android:textAppearance="@style/TextAppearance.AtenboroNav.Row" />

                <TextView
                    android:id="@+id/statusGisApi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/state_standby"
                    android:textAppearance="@style/TextAppearance.AtenboroNav.Caption" />
            </LinearLayout>

            <!-- Интернет -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <View
                    android:id="@+id/dotInet"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/dot_status_gray" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/row_inet"
                    android:textAppearance="@style/TextAppearance.AtenboroNav.Row" />

                <TextView
                    android:id="@+id/statusInet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/state_checking"
                    android:textAppearance="@style/TextAppearance.AtenboroNav.Caption" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartProxy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toTopOf="@+id/btnConnectEsp"
        app:layout_constraintTop_toBottomOf="@id/statusCard"
        android:text="@string/btn_start_proxy" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnectEsp"
        style="@style/Widget.AtenboroNav.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toTopOf="@+id/footerHint"
        app:layout_constraintTop_toBottomOf="@id/btnStartProxy"
        android:text="@string/btn_connect_esp" />

    <TextView
        android:id="@+id/footerHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/footer_hint"
        android:textAppearance="@style/TextAppearance.AtenboroNav.Caption"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnConnectEsp" />

</androidx.constraintlayout.widget.ConstraintLayout>
